{
  "name": "welearn-cli",
  "version": "0.1.0",
  "private": true,
  "description": "WE Learn 命令行自动化工具（个人学习与接口自动化练习用途）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "welearn-cli": "dist/index.js"
  },
  "scripts": {
